<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>AI 深度 · {{ report.title }}</title>
<style>
  :root {
    --bg: #ffffff; --fg: #1f2328; --muted: #656d76;
    --accent: #0969da; --accent-soft: #f0f7ff;
    --card: #ffffff; --border: #d0d7de;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --fg: #e6edf3; --muted: #8d96a0;
      --accent: #58a6ff; --accent-soft: #121d2f;
      --card: #161b22; --border: #30363d;
    }
  }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; line-height: 1.7; }
  .container { max-width: 720px; margin: 0 auto; padding: 20px 16px 48px; }
  header { border-bottom: 2px solid var(--accent); padding-bottom: 12px; margin-bottom: 20px; }
  h1 { font-size: 22px; margin: 0 0 6px; }
  .meta { color: var(--muted); font-size: 14px; }
  h2 { font-size: 17px; margin: 24px 0 8px; border-left: 4px solid var(--accent); padding-left: 10px; }
  section p { margin: 8px 0; font-size: 15px; }
  ul { margin: 8px 0; padding-left: 22px; font-size: 15px; }
  .role { font-weight: 600; }
  .refs a { color: var(--accent); word-break: break-all; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; min-width: 540px; font-size: 14px; }
  th, td { border: 1px solid var(--border); padding: 10px; text-align: left; vertical-align: top; }
  th { background: var(--accent-soft); }
  .scenario { border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin: 12px 0; }
  .scenario h3 { margin: 0 0 8px; font-size: 16px; }
  footer { margin-top: 32px; color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); padding-top: 12px; }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>AI 深度 · {{ report.title }}</h1>
    <div class="meta">{{ report.date }} · {% if report.version == '1.1' %}选型研究{% else %}事件追踪：{{ report.event_slug }}{% endif %}</div>
  </header>
  {% if report.version == '1.1' %}
  {% macro citations(ids) -%}
    {% for ref in report.references if ref.id in ids %}<a href="{{ ref.url }}">{{ ref.source }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
  {%- endmacro %}
  <section><h2>{{ report.decision_question }}</h2><p>{{ report.sections.verdict }}</p><p class="meta">{{ report.incremental_value }}</p></section>
  <section>
    <h2>证据与对照</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>维度</th><th>结果与对照</th><th>测试条件</th><th>如何解读</th></tr></thead>
      <tbody>{% for row in report.sections.comparisons %}
        <tr><td>{{ row.dimension }}</td><td>{{ row.finding }}<br>{{ citations(row.reference_ids) }}</td><td>{{ row.conditions }}</td><td>{{ row.interpretation }}</td></tr>
      {% endfor %}</tbody>
    </table></div>
  </section>
  <section>
    <h2>适用场景与边界</h2>
    {% set recommendations = {'recommended': '优先考虑', 'conditional': '有条件适用', 'not_recommended': '暂不建议', 'insufficient_evidence': '证据不足'} %}
    {% for row in report.sections.scenarios %}
    <div class="scenario"><h3>{{ row.task }} · {{ recommendations[row.recommendation] }}</h3><p>{{ row.reason }}</p><p class="meta">{% if row.evidence_boundary == 'measured' %}有直接测量证据{% else %}基于现有证据的场景推断，尚非业务实测结论{% endif %} · {{ citations(row.reference_ids) }}</p></div>
    {% endfor %}
  </section>
  <section><h2>成本与落地约束</h2><p>{{ report.sections.costs_and_constraints.analysis }}</p><p>{{ citations(report.sections.costs_and_constraints.reference_ids) }}</p></section>
  {% if report.sections.remaining_unknowns %}
  <section><h2>尚未解决的问题</h2><ul>{% for row in report.sections.remaining_unknowns %}<li><strong>{{ row.question }}</strong>（{% if row.kind == 'business_validation' %}业务验证{% else %}公开证据缺口{% endif %}）<br>已核查：{{ row.checked }}<br>对判断的影响：{{ row.decision_impact }}</li>{% endfor %}</ul></section>
  {% endif %}
  <section><h2>下一步</h2><p>{{ report.sections.next_action }}</p></section>
  {% else %}
  {# Historical 1.0 documents retain their original presentation. #}
  <section><h2>背景与时间线</h2><p>{{ report.sections.background }}</p></section>
  <section><h2>发布详述</h2><p>{{ report.sections.what_shipped_detail }}</p></section>
  <section><h2>基准与定价</h2><p>{{ report.sections.benchmarks_pricing }}</p></section>
  <section><h2>生态与第三方反应</h2><p>{{ report.sections.ecosystem_reaction }}</p></section>
  <section>
    <h2>对四个角色意味着什么</h2>
    <ul>
    {% for entry in report.sections.role_implications %}
      <li><span class="role">{{ entry.role }}：</span>{{ entry.implication }}</li>
    {% endfor %}
    </ul>
  </section>
  <section><h2>快速上手</h2><p>{{ report.sections.quick_start }}</p></section>
  <section>
    <h2>待验证问题</h2>
    <ul>
    {% for q in report.sections.open_questions %}
      <li>{{ q }}</li>
    {% endfor %}
    </ul>
  </section>
  {% endif %}
  <section class="refs">
    <h2>引用</h2>
    <ul>
    {% for ref in report.references %}
      <li>{{ ref.source }} — <a href="{{ ref.url }}">{{ ref.url }}</a>{% if report.version == '1.1' %}<br>{{ {'vendor_reported': '厂商披露', 'independent': '独立来源', 'team_test': '团队实测'}[ref.evidence_type] }} · 核验于 {{ ref.observed_at }}{% endif %}</li>
    {% endfor %}
    </ul>
  </section>
  <footer>生成于 {{ report.generated_at }} · AI 日报深度专题</footer>
</div>
</body>
</html>
