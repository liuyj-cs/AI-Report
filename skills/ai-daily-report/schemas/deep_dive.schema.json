{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIReportDeepDive",
  "type": "object",
  "required": ["version", "type", "date", "event_slug", "title", "generated_at", "sections", "references"],
  "properties": {
    "version": {"enum": ["1.0", "1.1"]},
    "type": {"const": "deep_dive"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "event_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 4, "maxLength": 80},
    "generated_at": {"type": "string"},
    "sections": {"type": "object"},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "url"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "evidence_type": {"enum": ["vendor_reported", "independent", "team_test"]},
          "observed_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision_question": {"type": "string", "minLength": 1},
    "incremental_value": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"version": {"const": "1.0"}}}, "then": {"properties": {"sections": {"$ref": "#/$defs/legacySections"}}}},
    {
      "if": {"properties": {"version": {"const": "1.1"}}},
      "then": {
        "required": ["decision_question", "incremental_value"],
        "properties": {
          "sections": {"$ref": "#/$defs/researchSections"},
          "references": {"items": {"required": ["id", "source", "url", "evidence_type", "observed_at"]}}
        }
      }
    }
  ],
  "$defs": {
    "legacySections": {
      "type": "object",
      "required": [
        "background",
        "what_shipped_detail",
        "benchmarks_pricing",
        "ecosystem_reaction",
        "role_implications",
        "quick_start",
        "open_questions"
      ],
      "properties": {
        "background": {"type": "string", "minLength": 80, "maxLength": 800},
        "what_shipped_detail": {"type": "string", "minLength": 150, "maxLength": 1200},
        "benchmarks_pricing": {"type": "string", "minLength": 50, "maxLength": 800},
        "ecosystem_reaction": {"type": "string", "minLength": 50, "maxLength": 800},
        "role_implications": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["role", "implication"],
            "properties": {
              "role": {"type": "string", "minLength": 2, "maxLength": 40},
              "implication": {"type": "string", "minLength": 20, "maxLength": 240}
            }
          }
        },
        "quick_start": {"type": "string", "minLength": 50, "maxLength": 600},
        "open_questions": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 120}}
      }
    },
    "researchSections": {
      "type": "object",
      "required": ["verdict", "comparisons", "scenarios", "costs_and_constraints", "remaining_unknowns", "next_action"],
      "properties": {
        "verdict": {"type": "string", "minLength": 1},
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dimension", "finding", "conditions", "interpretation", "reference_ids"],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "finding": {"type": "string", "minLength": 1},
              "conditions": {"type": "string", "minLength": 1},
              "interpretation": {"type": "string", "minLength": 1},
              "reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task", "recommendation", "reason", "evidence_boundary", "reference_ids"],
            "properties": {
              "task": {"type": "string", "minLength": 1},
              "recommendation": {"enum": ["recommended", "conditional", "not_recommended", "insufficient_evidence"]},
              "reason": {"type": "string", "minLength": 1},
              "evidence_boundary": {"enum": ["measured", "inferred"]},
              "reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
            }
          }
        },
        "costs_and_constraints": {
          "type": "object",
          "required": ["analysis", "reference_ids"],
          "properties": {
            "analysis": {"type": "string", "minLength": 1},
            "reference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
          }
        },
        "remaining_unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "kind", "checked", "decision_impact"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "kind": {"enum": ["public_evidence_gap", "business_validation"]},
              "checked": {"type": "string", "minLength": 1},
              "decision_impact": {"type": "string", "minLength": 1}
            }
          }
        },
        "next_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
